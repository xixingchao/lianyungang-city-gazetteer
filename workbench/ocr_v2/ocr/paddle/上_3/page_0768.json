349731}, {"text": "183.33", "score": 0.9999969601631165}, {"text": "72.74", "score": 0.9999979734420776}, {"text": "91.80", "score": 0.9999977350234985}, {"text": "0.43", "score": 0.9999964833259583}, {"text": "2.24", "score": 0.9999955892562866}, {"text": "0.51", "score": 0.9999984502792358}, {"text": "15.61", "score": 0.9999945759773254}, {"text": "1985", "score": 0.9999991655349731}, {"text": "193.53", "score": 0.9999974370002747}, {"text": "77.28", "score": 0.999997615814209}, {"text": "98.94", "score": 0.9999974966049194}, {"text": "0.33", "score": 0.9999955892562866}, {"text": "0.91", "score": 0.9999975562095642}, {"text": "16.07", "score": 0.9999943971633911}, {"text": "1986", "score": 0.9999984502792358}, {"text": "209.78", "score": 0.9999985098838806}, {"text": "84.53", "score": 0.999997615814209}, {"text": "114.29", "score": 0.9999973177909851}, {"text": "0.16", "score": 0.9999979734420776}, {"text": "0.86", "score": 0.9999960660934448}, {"text": "9.94", "score": 0.9999967813491821}, {"text": "1987", "score": 0.9999988079071045}, {"text": "205.82", "score": 0.9999983906745911}, {"text": "83.48", "score": 0.9999979138374329}, {"text": "112.68", "score": 0.9999973177909851}, {"text": "0.11", "score": 0.9999971389770508}, {"text": "0.24", "score": 0.9999982118606567}, {"text": "9.31", "score": 0.999998927116394}, {"text": "1988", "score": 0.9999992251396179}, {"text": "211.64", "score": 0.999997079372406}, {"text": "82.67", "score": 0.9999977350234985}, {"text": "118.39", "score": 0.9999979138374329}, {"text": "3.60", "score": 0.9999834299087524}, {"text": "2.06", "score": 0.9999736547470093}, {"text": "4.92", "score": 0.9999979138374329}, {"text": "1989", "score": 0.9999979734420776}, {"text": "217.27", "score": 0.9999950528144836}, {"text": "85.55", "score": 0.9999974370002747}, {"text": "124.00", "score": 0.9999893307685852}, {"text": "4.00", "score": 0.9999874830245972}, {"text": "2.47", "score": 0.9999982118606567}, {"text": "1.25", "score": 0.9999949336051941}, {"text": "1990", "score": 0.9999986290931702}, {"text": "240.67", "score": 0.9999982714653015}, {"text": "72.30", "score": 0.9999969601631165}, {"text": "137.00", "score": 0.9999908804893494}, {"text": "21.00", "score": 0.9999865293502808}, {"text": "6.16", "score": 0.9999960660934448}, {"text": "4.21", "score": 0.999995231628418}, {"text": "四、专用盐", "score": 0.99955815076828}, {"text": "储备盐储备盐，又叫移储盐、战备盐，古称常平盐。汉宣帝时于边境筑仓，名谓常平", "score": 0.9991880655288696}, {"text": "仓。唐代盐铁使刘晏仿照“贮粮于常平仓”的办法，创立常平盐制度，即由官府调运部分盐", "score": 0.9995212554931641}, {"text": "到边境荒僻地方贮存，一旦商人囤积居奇，哄抬盐价时，即开仓平价供应市场。宋、元时期", "score": 0.9885180592536926}, {"text": "淮北盐场在新浦、涟水各交通要道设置盐仓，贮盐50~100万担。元至元二十一年(1284", "score": 0.9934338331222534}, {"text": "年)在淮安(管辖海州)府设局负责接储和管理常平盐工作。民国25年(1936年)国民政府", "score": 0.9980743527412415}, {"text": "在淮北盐场轮运常平盐600余万担分别移储扬子四岸。民国36年，办运常平盐82.77万", "score": 0.9992596507072449}, {"text": "担，其中本销36.1万担，代办外销46.67万担。", "score": 0.9978989958763123}, {"text": "1953~1959年，国家核定江苏省收购淮北储备盐(常平盐)50.29万吨，储存产区", "score": 0.9833875298500061}, {"text": "32.29万吨，其中猴嘴坨15.6万吨、徐圩坨3.69万吨、燕尾坨2.04万吨、陈港坨10.92万", "score": 0.9972553849220276}, {"text": "吨。移储在销区18万吨。1964年贯彻“备战备荒为人民”的方针，国家拨款办运战备盐，", "score": 0.9997350573539734}, {"text": "按照“统一管理，分级负责”的原则，由轻工业部归口，中国盐业公司负责管理。江苏省盐", "score": 0.999707818031311}, {"text": "业公司于1964年开始调查摸底，选址定点，1965年由淮北盐场调拨，各盐业批发站具体接", "score": 0.9993054866790771}, {"text": "储。到1983年共有移储盐14.78万吨，分别移储29个县、市，44个点，92条廪(库)。其中", "score": 0.9812704920768738}, {"text": "城镇储点20个，乡村储点24个。县城以下储存11.84万吨，占全部存盐的80.11%；露天", "score": 0.9831470847129822}, {"text": "储存占94%，仓库储存占6%。到1990年底尚有移储盐14.3万吨。", "score": 0.9988323450088501}, {"text": "加碘盐 淮北供应加碘盐，从1982年开始。江苏省内有10个县(市)210个乡镇发现", "score": 0.9859168529510498}, {"text": "有甲状腺病，病区总人口数620万人，甲状腺肿病人有18万人。为病区供应加碘盐的人", "score": 0.9992502331733704}, {"text": "口有550万人。淮北盐场除供应江苏省甲状腺肿病区外，还为山东、安徽、贵州、湖南等省", "score": 0.999520480632782}, {"text": "加工加碘盐。历年所产加碘盐全部销罄。", "score": 0.9994952082633972}, {"text": "出口盐 民国8年(1919年)，北洋政府特许淮盐接济日本100万担，由盐务署与日本", "score": 0.9754404425621033}]}